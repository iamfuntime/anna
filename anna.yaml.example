# ============================================================
# ANNA configuration
#
# Non-secret runtime config lives here. Secrets live in .env.
# The runtime loads this file once at startup. Edits do not take
# effect until anna is restarted (`systemctl --user restart anna`).
# ============================================================

# ============================================================
# Auth path
# ============================================================
auth:
  # "max" or "api_key". When "max", ANNA reuses the Claude Code saved
  # session and inherits the operator's MAX plan rate limits. When
  # "api_key", ANNA reads ANTHROPIC_API_KEY from .env.
  mode: max

# ============================================================
# Runtime
# ============================================================
runtime:
  # Claude Agent SDK tool-permission gate. ANNA is a headless service —
  # no operator at a terminal to approve tool calls — so the default is
  # "bypassPermissions". Valid values:
  #   bypassPermissions  no prompts, ANNA runs tools freely (default)
  #   acceptEdits        auto-approve file edits, prompt on the rest
  #   plan               read-only planning mode, no writes
  #   default            interactive prompts (do not use in a service)
  permission_mode: bypassPermissions

# ============================================================
# Transports
#
# Each transport gets one section. The runtime starts a listener
# for every transport with enabled: true. The setup wizard discovers
# adapter plugins under src/anna/transports/ and populates this block.
# ============================================================
transports:
  slack:
    enabled: false
  telegram:
    enabled: false

# ============================================================
# Vault
# ============================================================
vault:
  # Root directory for ANNA's markdown vault. Conversations, Identity
  # archives, sub-agent personas, and skills all live under this root.
  # Obsidian users typically point this inside their existing vault;
  # everyone else uses a standalone directory.
  path: ~/anna/vault

# ============================================================
# Watchdog
# ============================================================
watchdog:
  # How often the watchdog loops. Default 300 seconds (5 minutes).
  interval_seconds: 300
  # Seconds without forward progress before a worker is flagged as stalled.
  worker_stall_seconds: 90
  # Whether to restart stalled workers (true) or only log them (false).
  restart_stalled_workers: false

# ============================================================
# Logging
# ============================================================
logging:
  # DEBUG, INFO, WARNING, ERROR, CRITICAL. Env var ANNA_LOG_LEVEL overrides.
  level: INFO
  # "json" (default, for journald) or "text" (for local hacking).
  format: json
  audit:
    enabled: true
    # Days retained. 0 means forever.
    retention_days: 365
    # Whether to fsync after every audit write. The cost is small because
    # audit events are not high-frequency, and the benefit is that an OS
    # crash does not lose audit data.
    fsync_on_write: true
  transcripts:
    enabled: true
    # Days before transcripts are gzipped. Runtime deletes at 3 times this.
    # 0 means forever, no gzip, no delete.
    retention_days: 30
  ship:
    # Phase 2 stub. Setting this true in Phase 1 raises a config error.
    enabled: false
    destination: ""
    format: json

# ============================================================
# Housekeeping
# ============================================================
housekeeping:
  # Local time the daily sweep runs (audit retention, transcript gzip
  # and delete, vault index refresh). HH:MM 24h.
  daily_sweep_time: "03:17"

# ============================================================
# Session boundaries
# ============================================================
sessions:
  # Hours of inactivity before a DM-style conversation is considered closed.
  # Worker writes a vault checkpoint and terminates.
  dm_gap_hours: 8
  # Hours of inactivity before a thread or group-style conversation is closed.
  thread_gap_hours: 1

# ============================================================
# Operator alerts
#
# When the watchdog restarts a transport, the operator should learn about
# it on the OTHER transport. When the SDK auth fails, both transports get
# notified. Either destination may be left blank; the alerter logs a
# warning and skips when no destination is configured for the surviving
# channel.
# Env-var equivalents: ANNA_ADMIN_SLACK_CHANNEL_ID, ANNA_ADMIN_TELEGRAM_CHAT_ID.
# ============================================================
admin:
  # Slack channel ID (e.g. C0123ABC) the bot is a member of.
  slack_channel_id: ""
  # Operator's Telegram chat ID as a string.
  telegram_chat_id: ""
  # Fire a one-shot alert at boot tagged clean (sentinel found at
  # $ANNA_HOME/state/last_clean_shutdown) or UNCLEAN (sentinel missing —
  # crash, kill, or power loss). Set false to silence boot pings.
  startup_alert: true

# ============================================================
# Scheduler (Phase 2)
#
# Fires scheduled prompts through the worker pool. Schedules persist
# to state_path as YAML; create/update/delete them at runtime via the
# anna_self_edit MCP tools (schedule_create, schedule_update, etc.).
# The scheduler polls every poll_interval_seconds for due schedules,
# dispatches a synthetic InboundEvent through the router, and routes
# the worker's final reply to the per-schedule destination (a non-admin
# Slack channel or Telegram chat). Three consecutive failures
# auto-disables the schedule and alerts admin.
# ============================================================
scheduler:
  enabled: true
  # Where the on-disk schedule list lives. Operator-editable for one-off
  # repairs, but normal create/update/delete should go through the MCP
  # tools so the supervisor lock and audit trail are honored.
  state_path: ~/anna/schedules.yaml
  # Per-fire wall-clock cap if a schedule does not specify its own.
  default_timeout_seconds: 300
  # Hard cap on simultaneously-firing schedules. Beyond this, fires queue.
  max_concurrent: 3
  # Loop cadence. 30s matches the cron 1-minute floor with one cycle of
  # safety margin; finer granularity would not buy anything.
  poll_interval_seconds: 30
  # Consecutive-failure count that auto-disables a schedule and fires
  # AdminAlerter.warn(). The schedule stays in state_path with enabled:
  # false until the operator re-enables it.
  failure_threshold: 3

# ============================================================
# google: read-only (phase 1) Gmail + Calendar across multiple accounts.
# See Inbox/2026-06-01-ANNA-Google-Workspace-OAuth-Setup.md for the
# one-time GCP project + service-account + Workspace DWD setup.
# ============================================================
google:
  # Master kill switch. When false, the google MCP server is not mounted
  # and the google_* tools are unavailable to workers.
  enabled: false
  # Per-account list. slug is the handle ANNA passes to every tool call.
  # auth_type is "oauth" (personal Gmail) or "service_account" (Workspace
  # with domain-wide delegation). credentials_file is resolved relative to
  # $ANNA_HOME when not absolute.
  #
  # accounts:
  #   - slug: personal_main
  #     email: you@gmail.com
  #     auth_type: oauth
  #     credentials_file: state/google/oauth_client.json
  #   - slug: emergentsec
  #     email: you@emergentsec.com
  #     auth_type: service_account
  #     credentials_file: state/google/sa_emergentsec.json
  accounts: []
  # Phase 2 write tools (drafts, sends, calendar mutations) are gated
  # behind this flag. Keep off until you trust scheduled prompts to send
  # mail on their own.
  write_enabled: false
