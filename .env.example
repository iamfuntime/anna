# ============================================================
# ANNA environment file
#
# The setup wizard writes this file at ~/anna/.env with chmod 600.
# Every variable that ANNA reads at runtime is documented here.
# Anything not listed should not be set; the wizard is the source
# of truth for what ANNA expects.
# ============================================================

# ============================================================
# Auth (pick one path; the wizard sets ANNA_AUTH_MODE for you)
# ============================================================

# "max" uses the operator's Claude Code saved session (claude login).
# "api" uses an Anthropic API key. There is no automatic fallback at runtime.
ANNA_AUTH_MODE=max

# Only set this when ANNA_AUTH_MODE=api. The wizard accepts the key
# interactively and writes it here; secrets are never accepted on the
# command line.
# ANTHROPIC_API_KEY=

# ============================================================
# Slack (only set when slack is enabled in anna.yaml)
# ============================================================

# Bot user OAuth token (xoxb-...). Required for chat.postMessage and other
# Web API calls.
# SLACK_BOT_TOKEN=

# App-Level token (xapp-...). Required for Socket Mode.
# SLACK_APP_TOKEN=

# Optional signing secret. Only required if the operator chooses HTTPS
# webhooks instead of Socket Mode (not the recommended path for homelab).
# SLACK_SIGNING_SECRET=

# Comma-separated list of Slack user IDs allowed to DM the bot. Empty
# means anyone in the workspace can reach it. The wizard suggests pinning
# this to the operator's own user ID.
# ANNA_SLACK_ALLOWED_USERS=

# ============================================================
# Telegram (only set when telegram is enabled in anna.yaml)
# ============================================================

# Bot token from BotFather (123456:ABC-DEF...).
# TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram numeric user IDs allowed to message the
# bot. Empty means anyone who finds the bot can talk to it; the wizard
# strongly suggests pinning this.
# ANNA_TELEGRAM_ALLOWED_USERS=

# ============================================================
# Logging (optional, sensible defaults apply)
# ============================================================

# DEBUG, INFO, WARNING, ERROR, CRITICAL. Default INFO.
ANNA_LOG_LEVEL=INFO

# "json" (default, recommended for journald) or "text" (for local hacking).
ANNA_LOG_FORMAT=json

# Reasoning-effort override for the MAIN conversation loop (wins over
# runtime.effort in anna.yaml). low|medium|high|xhigh|max; unset = SDK
# default (high). Sub-agents do not inherit this.
# ANNA_RUNTIME_EFFORT=xhigh

# Scheduled-turn narration consolidation. When true (the default), a
# scheduled/non-interactive turn posts ONLY its terminal report and discards
# mid-turn narration that accompanied tool calls. Set false to restore the
# legacy full-narration capture. An explicit runtime.visibility.
# consolidate_scheduled_turns in anna.yaml wins over this env var.
# ANNA_CONSOLIDATE_SCHEDULED_TURNS=true

# Days of audit log files retained before the housekeeping coroutine deletes
# them. 0 means forever. Default 365.
ANNA_AUDIT_RETENTION_DAYS=365

# Days of transcript files retained before they are gzipped. The runtime
# deletes them at three times this number of days. 0 means forever, no gzip,
# no delete. Default 30.
ANNA_TRANSCRIPT_RETENTION_DAYS=30

# External log shipping destination (Phase 2). Leave empty in Phase 1.
ANNA_LOG_SHIP_DESTINATION=

# ============================================================
# Vault paths
# ============================================================

# Root directory for ANNA's markdown vault. Defaults to ~/Obsidian/ANNA.
# The operator can point this anywhere; the wizard offers a default and
# accepts an override.
ANNA_VAULT_ROOT=~/Obsidian/ANNA

# Root directory for ANNA's runtime artifacts (core identity files, audit
# log, transcripts). Defaults to ~/anna.
ANNA_HOME=~/anna

# ============================================================
# Operator alert destinations (optional)
# ============================================================
#
# When the watchdog restarts a transport or the SDK auth fails, ANNA tries
# to reach the operator on the surviving channel. These two env vars
# configure the destinations; anna.yaml's admin: block is the other way to
# set them.
#
# Slack: a channel ID the bot is a member of (e.g. C0123ABC).
# ANNA_ADMIN_SLACK_CHANNEL_ID=
#
# Telegram: the operator's numeric chat ID as a string.
# ANNA_ADMIN_TELEGRAM_CHAT_ID=

# ============================================================
# Phase 2 §2 tool surface
# ============================================================
#
# Brave Search REST credential. Required when tools.web_search.provider is
# "brave" (the only provider that currently ships). Free tier is 2k
# queries/month — enough for a daily morning brief plus threat-research
# bursts. Get one at https://api.search.brave.com/.
# BRAVE_SEARCH_API_KEY=

# ============================================================
# Phase 2.5 voice messages
# ============================================================
#
# OpenAI API credential. Used by both inbound transcription (Whisper)
# and outbound text-to-speech (tts-1) when the respective providers in
# anna.yaml's voice: block are the OpenAI defaults. Whisper costs
# ~$0.006/min of audio; tts-1 costs ~$15/1M chars. Get one at
# https://platform.openai.com/api-keys.
# OPENAI_API_KEY=
