[Unit]
# Systemd user unit for ANNA.
#
# Installed by the setup wizard to ~/.config/systemd/user/anna.service.
# Enable and start with:
#   systemctl --user daemon-reload
#   systemctl --user enable --now anna
#   loginctl enable-linger $USER   # keep running when not logged in
Description=ANNA: Adaptive Neural Network Assistant
Documentation=https://github.com/iamfuntime/anna
After=network-online.target
Wants=network-online.target

[Service]
# Type=simple: the process stays in the foreground, systemd treats the
# main PID as the service. ANNA does its own asyncio loop and never forks.
Type=simple

# %h expands to the operator's home directory at unit-load time.
WorkingDirectory=%h/anna

# The venv created by install.sh holds the anna entrypoint script.
ExecStart=%h/anna/.venv/bin/anna

# Restart on any non-clean exit. SIGTERM during shutdown is treated as
# clean; the supervisor handles graceful drain of the worker pool.
Restart=on-failure
RestartSec=10

# KillMode=mixed: SIGTERM goes only to the main PID (the asyncio loop in
# __main__.py); child processes survive long enough for the closeout path
# in ConversationRouter.shutdown() to query the Claude SDK subprocess for
# each worker's checkpoint summary. Without this, SIGTERM hits the whole
# cgroup and the SDK subprocess dies concurrently, forcing closeout to
# fall back to a placeholder summary. TimeoutStopSec bounds how long
# systemd waits before SIGKILLing the rest of the cgroup if the main
# process has not exited. 180s aligns with §3's sub-agent default timeout
# (300s) divided across worst-case parallelism — closeout has to drain
# any in-flight sub-agent work plus query the SDK for summaries. Earlier
# 60s value SIGKILL'd the cgroup mid-closeout on 2026-06-02.
KillMode=mixed
TimeoutStopSec=180

# Forward stdout and stderr to the user journal. ANNA emits structured
# JSON to stdout; journald stores it. The anna-logs wrapper reads it back
# with journalctl --user -u anna.
StandardOutput=journal
StandardError=journal

# Plain memory limit to keep a runaway worker pool from eating the host.
# Adjust if the operator runs many sub-agents in parallel.
MemoryMax=2G

# Drop a few capabilities ANNA never needs. The user unit cannot tighten
# much beyond this without breaking the SDK's subprocess launches.
NoNewPrivileges=true

[Install]
# default.target is the user equivalent of multi-user.target; enabling
# adds this unit to the operator's login session.
WantedBy=default.target
